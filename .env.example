# Required
SECRET_KEY=change-me-to-a-long-random-string

# Optional
# PORT=5000
# FLASK_DEBUG=true                # auto-reload for local development (never in production)
# DATABASE_URL=sqlite:///instance/docindex.sqlite
# TESSERACT_LANGS=eng+por

# AI (OpenAI-compatible endpoint: Ollama, LM Studio, OpenAI API, ...)
# AI_ENABLED=true
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=
# AI_MODEL=llama3.1
# AI_VISION_MODEL=llava
# AI_MAX_STEPS=12
# AI_RATE_LIMIT_RPM=30
# AI_REQUEST_TIMEOUT=300
# AI_HASHTAG_MAX_WORDS=6          # max words per AI-generated hashtag
# AI_STREAMING=true               # token-by-token chat; false if provider breaks
# SEARCH_FTS=true                 # FTS5 search (BM25); false forces ILIKE fallback
# INDEX_WORKERS=2                 # background threads draining the index queue
# ERROR_LOG_KEEP=2000             # rows kept in the error log (/settings/logs)
